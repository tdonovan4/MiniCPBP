<instance format="XCSP3" type="CSP">
    <variables>
        <array id="x" size="[3]"> 1..3 </array>
    </variables>
    <constraints>
        <extension>
            <list> x[0] x[1] x[2] </list>
            <supports> (1,2,3)(2,3,1)(3,1,2) </supports>
        </extension>
        <extension>
            <list> x[0] x[1] x[2] </list>
            <supports> (1,2,3)(3,3,1)(2,1,2) </supports>
        </extension>
    </constraints>
</instance>
